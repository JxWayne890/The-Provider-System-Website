# Shared app protection. Use a long random value.
ANALYTICS_ACCESS_TOKEN=

# Site settings.
SITE_NAME=The Provider System
PUBLIC_SITE_URL=https://theprovidersystem.com/

# Google Search Console API.
# Add the service account email as a user on the Search Console property.
GSC_SITE_URL=sc-domain:theprovidersystem.com
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Bing Webmaster Tools API.
# Generate this inside Bing Webmaster Tools > Settings > API access.
BING_SITE_URL=https://theprovidersystem.com
BING_API_KEY=
